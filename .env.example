# Google Gemini API Key (Get free with your Google account at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# YouTube Data API v3 OAuth 2.0 Credentials (From Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI must include: http://localhost:8000/api/youtube/oauth2callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth2callback
